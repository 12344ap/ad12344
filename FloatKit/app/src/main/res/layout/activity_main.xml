<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="26dp"
        android:paddingRight="20dp"
        android:paddingBottom="36dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="返回 · 截屏 · 录屏 · 锁屏，一颗悬浮球全部搞定"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- 运行状态 -->
        <LinearLayout style="@style/Card">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="运行状态"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="未运行"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Android 7.0+"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:text="权限检查" />

        <!-- 悬浮窗权限 -->
        <LinearLayout style="@style/PermRow">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    style="@style/RowTitle"
                    android:text="悬浮窗权限" />
                <TextView
                    android:id="@+id/tv_overlay"
                    style="@style/RowSub"
                    android:text="未开启（必需）" />
            </LinearLayout>
            <Button
                android:id="@+id/btn_overlay"
                style="@style/RowButton"
                android:text="开启" />
        </LinearLayout>

        <!-- 无障碍服务 -->
        <LinearLayout style="@style/PermRow">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    style="@style/RowTitle"
                    android:text="无障碍服务" />
                <TextView
                    android:id="@+id/tv_a11y"
                    style="@style/RowSub"
                    android:text="未开启（返回 / 主页 / 锁屏需要）" />
            </LinearLayout>
            <Button
                android:id="@+id/btn_a11y"
                style="@style/RowButton"
                android:text="开启" />
        </LinearLayout>

        <!-- 运行时权限 -->
        <LinearLayout style="@style/PermRow">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    style="@style/RowTitle"
                    android:text="通知 / 麦克风 / 存储" />
                <TextView
                    android:id="@+id/tv_runtime"
                    style="@style/RowSub"
                    android:text="未授予" />
            </LinearLayout>
            <Button
                android:id="@+id/btn_runtime"
                style="@style/RowButton"
                android:text="授权" />
        </LinearLayout>

        <!-- 电池优化 -->
        <LinearLayout style="@style/PermRow">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    style="@style/RowTitle"
                    android:text="后台运行保护" />
                <TextView
                    android:id="@+id/tv_battery"
                    style="@style/RowSub"
                    android:text="未加入电池优化白名单" />
            </LinearLayout>
            <Button
                android:id="@+id/btn_battery"
                style="@style/RowButton"
                android:text="设置" />
        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:text="行为设置" />

        <LinearLayout style="@style/PermRow">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    style="@style/RowTitle"
                    android:text="开机自动启动" />
                <TextView
                    style="@style/RowSub"
                    android:text="重启手机后自动恢复悬浮球" />
            </LinearLayout>
            <Switch
                android:id="@+id/sw_boot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumbTint="@color/accent"
                android:trackTint="@color/track_tint" />
        </LinearLayout>

        <LinearLayout style="@style/PermRow">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    style="@style/RowTitle"
                    android:text="松手自动贴边" />
                <TextView
                    style="@style/RowSub"
                    android:text="拖动悬浮球后自动吸附到屏幕边缘" />
            </LinearLayout>
            <Switch
                android:id="@+id/sw_snap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumbTint="@color/accent"
                android:trackTint="@color/track_tint" />
        </LinearLayout>

        <LinearLayout style="@style/PermRow">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    style="@style/RowTitle"
                    android:text="录屏时隐藏悬浮球" />
                <TextView
                    style="@style/RowSub"
                    android:text="避免录进去；可通过通知栏停止录屏" />
            </LinearLayout>
            <Switch
                android:id="@+id/sw_record_hide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumbTint="@color/accent"
                android:trackTint="@color/track_tint" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_start"
            style="@style/PrimaryButton"
            android:text="启动悬浮窗" />

        <Button
            android:id="@+id/btn_stop"
            style="@style/SecondaryButton"
            android:text="停止悬浮窗" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:lineSpacingExtra="4dp"
            android:text="使用说明\n1. 悬浮球可以拖动到屏幕任意位置，点击展开菜单。\n2. 顶部菜单中的“返回 / 主页 / 多任务 / 锁屏”依赖无障碍服务。\n3. 截屏、录屏每次都会弹出系统授权框，建议选择“整个屏幕”。\n4. 录屏时悬浮球默认隐藏，可在通知栏点“停止录屏”。\n5. 应用不联网、不上传数据，截图与录像只保存在本机相册。"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
